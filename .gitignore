.DS_Store
dist/
node_modules/
controller/static/platform.js
controller/static/assets/
installer/assets/controller.exe
*.db
*.log
*.bak
*.tmp
controller/chrome-profile
controller/yui_controller
controller/diagnostics.txt
controller/controller.json
controller/controller.log
controller/status.json
installer/installer
~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

*.sqlite3
