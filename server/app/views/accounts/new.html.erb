<% content_for :title, "New account - Yui" %>

<main class="form-page">
  <section class="form-card">
    <%= link_to "< Accounts", accounts_path, class: "back-link" %>
    <h1>New account</h1>

    <%= form_with model: @account, class: "account-form" do |form| %>
      <% if @account.errors.any? %>
        <div class="form-errors">
          <strong>Check these details</strong>
          <ul>
            <% @account.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <label class="field">
        <span>Name</span>
        <%= form.text_field :name, autofocus: true, placeholder: "Studio, shop, or person" %>
      </label>

      <label class="field">
        <span>Profile image URL</span>
        <%= form.url_field :profile_image_url, placeholder: "https://example.com/avatar.jpg" %>
      </label>

      <div class="form-actions">
        <%= form.submit "Create account", class: "button button--primary" %>
      </div>
    <% end %>
  </section>
</main>
