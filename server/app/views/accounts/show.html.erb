<% content_for :title, "#{@account.name} - Yui" %>

<% online_kiosks = @kiosks.count { |kiosk| kiosk.last_seen_at.present? && kiosk.last_seen_at > 10.minutes.ago } %>
<% pending_commands = @commands.count { |command| command.status == "pending" } %>
<% collections = @state_records.group_by(&:collection) %>

<main class="workspace">
  <section class="project-card">
    <header class="project-card__header">
      <div class="project-card__header-actions">
        <%= link_to "← Manage Accounts", accounts_path, class: "back-link" %>
      </div>
      <span class="mini-avatar">
        <% if (profile_image_url = account_profile_image_url(@account)).present? %>
          <img src="<%= profile_image_url %>" alt="">
        <% else %>
          <span><%= @account.name.to_s.first&.upcase || "Y" %></span>
        <% end %>
      </span>
      <h1><%= @account.name %></h1>

      <%= link_to "Edit", edit_account_path(@account), class: "button button--ghost" %>
    </header>

    <section class="project-section project-section--pairing">
      <div>
        <h2>Pairing</h2>
      </div>
      <%= button_to "Create pairing code", account_pairing_codes_path(@account), method: :post, class: "button button--primary" %>
    </section>

    <section class="project-section project-section--pairing">
      <div>
        <h2>Phones</h2>
        <% if @phone_links.any? %>
          <ul class="plain-list">
            <% @phone_links.each do |link| %>
              <li>
                <span>
                  <strong><%= link.label.presence || "Phone" %></strong>
                  <small>Last used <%= link.last_used_at ? time_ago_in_words(link.last_used_at) + " ago" : "never" %></small>
                </span>
                <%= button_to "Revoke", account_phone_link_path(@account, link), method: :delete, class: "button button--ghost" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>No phones play as this account yet.</p>
        <% end %>
      </div>
      <%= button_to "Link a phone", account_phone_links_path(@account), method: :post, class: "button button--primary" %>
    </section>

    <section class="project-grid" aria-label="Account workspace">
      <article class="project-cell">
        <h2>Kiosks</h2>
        <% if @kiosks.any? %>
          <ul class="plain-list">
            <% @kiosks.each do |kiosk| %>
              <li>
                <span>
                  <strong><%= link_to kiosk.name, account_kiosk_path(@account, kiosk) %></strong>
                  <small><%= kiosk.last_seen_at.present? ? "Last seen #{time_ago_in_words(kiosk.last_seen_at)} ago" : "Never seen" %><%= " · #{kiosk.chrome_label}" if kiosk.chrome_state %></small>
                </span>
                <span class="quiet-status <%= "quiet-status--on" if kiosk.last_seen_at.present? && kiosk.last_seen_at > 10.minutes.ago %>">
                  <%= kiosk.last_seen_at.present? && kiosk.last_seen_at > 10.minutes.ago ? "Online" : "Idle" %>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="empty-copy">No kiosks are paired yet.</p>
        <% end %>
      </article>

      <article class="project-cell">
        <h2>Collections</h2>
        <% if collections.any? %>
          <ul class="plain-list collection-tree">
            <% collections.first(8).each do |collection, records| %>
              <li>
                <details>
                  <summary>
                    <span>
                      <strong><%= collection %></strong>
                      <small><%= pluralize(records.size, "record") %></small>
                    </span>
                    <span class="quiet-status">Folder</span>
                  </summary>
                  <ul class="collection-tree__records">
                    <% records.first(10).each do |record| %>
                      <li>
                        <details>
                          <summary>
                            <span>
                              <strong><%= record.record_id %></strong>
                              <small><%= record.deleted? ? "Deleted" : "Server seq ##{record.server_seq}" %></small>
                            </span>
                            <span class="quiet-status <%= "quiet-status--failed" if record.deleted? %>">
                              <%= record.deleted? ? "Deleted" : "Record" %>
                            </span>
                          </summary>
                          <% pretty_value = JSON.pretty_generate(record.value || {}) %>
                          <% truncated_value = pretty_value.length > 4_000 ? "#{pretty_value.first(4_000)}\n..." : pretty_value %>
                          <pre class="collection-tree__value"><%= truncated_value %></pre>
                        </details>
                      </li>
                    <% end %>
                    <% if records.size > 10 %>
                      <li class="collection-tree__more">
                        <span><%= pluralize(records.size - 10, "more record") %></span>
                      </li>
                    <% end %>
                  </ul>
                </details>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="empty-copy">State records will appear after a kiosk syncs.</p>
        <% end %>
      </article>

      <article class="project-cell">
        <div class="project-cell__header">
          <h2>Recent Commands</h2>
          <% if @commands.any? %>
            <%= button_to "Clear", recent_commands_account_path(@account), method: :delete, class: "button button--ghost button--small", form: { data: { turbo_confirm: "Clear recent commands from this view?" } } %>
          <% end %>
        </div>
        <% if @commands.any? %>
          <ol class="plain-list plain-list--ordered">
            <% @commands.first(8).each do |command| %>
              <li>
                <span>
                  <strong><%= command.command_type %></strong>
                  <small><%= command.kiosk.name %> - <%= time_ago_in_words(command.created_at) %> ago</small>
                </span>
                <span class="quiet-status quiet-status--<%= command.status %>"><%= command.status %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="empty-copy">No commands have been queued yet.</p>
        <% end %>
      </article>

      <article class="project-cell">
        <div class="project-cell__header">
          <h2>Recent Logs</h2>
          <% if @operations.any? %>
            <%= button_to "Clear", recent_operations_account_path(@account), method: :delete, class: "button button--ghost button--small", form: { data: { turbo_confirm: "Clear recent logs from this view?" } } %>
          <% end %>
        </div>
        <% if @operations.any? %>
          <ol class="plain-list plain-list--ordered">
            <% @operations.first(8).each do |operation| %>
              <li>
                <span>
                  <strong><%= operation.action %></strong>
                  <small><%= operation.collection %>/<%= operation.record_id %></small>
                </span>
                <span class="quiet-status">#<%= operation.server_seq %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="empty-copy">Device logs will appear here as they sync.</p>
        <% end %>
      </article>
    </section>

    <%= render "accounts/play_sessions", kiosks: @kiosks %>
    <%= render "linked_accounts/section", account: @account, linked_accounts: @linked_accounts %>
    <section id="asset-library" class="project-section project-section--assets"
             data-controller="asset-library"
             data-asset-library-url-value="<%= account_assets_path(@account) %>"
             data-action="asset-upload:changed->asset-library#refresh turbo:frame-load->asset-library#loaded">
      <div class="project-cell__header">
        <h2>Asset Library</h2>
      </div>

      <form class="asset-upload" data-controller="asset-upload"
            data-asset-upload-endpoint-value="<%= account_asset_uploads_url(@account) %>"
            data-action="submit->asset-upload#start">
        <label class="field asset-upload__file">
          <span>File</span>
          <input type="file" name="file" required data-asset-upload-target="file">
        </label>
        <label class="field">
          <span>Kind</span>
          <%= select_tag :kind, options_for_select(asset_kind_options, "game"), data: { asset_upload_target: "kind", action: "asset-upload#toggleRuntime" } %>
        </label>
        <label class="field">
          <span>Title <small>(optional)</small></span>
          <input type="text" name="title" maxlength="200" placeholder="From the disc or file name" data-asset-upload-target="title">
        </label>
        <div class="asset-upload__runtime" data-asset-upload-target="runtimeFields" hidden>
          <label class="field">
            <span>Runtime</span>
            <input type="text" name="runtime" maxlength="64" placeholder="dolphin" data-asset-upload-target="runtime">
          </label>
          <label class="field">
            <span>Version</span>
            <input type="text" name="version" maxlength="64" placeholder="2509" data-asset-upload-target="version">
          </label>
        </div>
        <div class="asset-upload__actions">
          <button type="submit" class="button button--primary" data-asset-upload-target="submit">Upload</button>
          <button type="button" class="button button--ghost" data-asset-upload-target="pause" data-action="asset-upload#pause" hidden>Pause</button>
        </div>
        <progress class="asset-progress asset-upload__progress" value="0" max="1" data-asset-upload-target="progress" hidden></progress>
        <p class="asset-upload__message" data-asset-upload-target="message" aria-live="polite"></p>
      </form>

      <%= render "assets/library", account: @account, assets: @assets, kiosks: @kiosks %>
    </section>

    <section class="project-section project-section--commands">
      <% if @kiosks.any? %>
        <div class="command-stack">
          <% @kiosks.each do |kiosk| %>
            <%= form_with url: account_kiosk_commands_path(@account), method: :post, class: "command-form" do |form| %>
              <%= hidden_field_tag :kiosk_id, kiosk.id %>
              <div class="command-form__device">
                <strong><%= kiosk.name %></strong>
                <small><code><%= kiosk.device_uid %></code></small>
              </div>
              <label>
                <span>Command</span>
                <%= select_tag :command_type, options_for_select(KioskCommand::ALLOWED_TYPES) %>
              </label>
              <label>
                <span>Payload</span>
                <%= text_area_tag :payload, "{}", rows: 2 %>
              </label>
              <%= submit_tag "Queue", class: "button button--dark" %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="empty-copy">Pair a kiosk before sending commands.</p>
      <% end %>
    </section>
  </section>
</main>
