<% content_for :title, "Edit #{@account.name} - Yui" %>

<main class="form-page">
  <section class="form-card">
    <%= link_to "< Account", account_path(@account), class: "back-link" %>
    <h1>Edit account</h1>

    <%= form_with model: @account, class: "account-form" do |form| %>
      <% if @account.errors.any? %>
        <div class="form-errors">
          <strong>Check these details</strong>
          <ul>
            <% @account.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <label class="field">
        <span>Name</span>
        <%= form.text_field :name, autofocus: true %>
      </label>

      <label class="field">
        <span>Profile picture</span>
        <%= form.file_field :profile_image, accept: "image/png,image/jpeg,image/gif,image/webp" %>
      </label>

      <% if @account.profile_image.attached? %>
        <label class="check-field">
          <%= check_box_tag "account[remove_profile_image]", "1" %>
          <span>Remove uploaded picture</span>
        </label>
      <% end %>

      <label class="field">
        <span>Profile image URL fallback</span>
        <%= form.url_field :profile_image_url, placeholder: "https://example.com/avatar.jpg" %>
      </label>

      <div class="form-actions">
        <%= form.submit "Save account", class: "button button--primary" %>
      </div>
    <% end %>

    <div class="danger-zone">
      <h2>Delete account</h2>
      <p>This removes the account and its kiosks, pairing codes, commands, operations, and synced state.</p>
      <%= button_to "Delete account", account_path(@account), method: :delete, class: "button button--danger", form: { data: { turbo_confirm: "Delete #{@account.name}? This cannot be undone." } } %>
    </div>
  </section>
</main>
