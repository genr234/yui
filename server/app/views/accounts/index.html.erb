<% content_for :title, "Choose account - Yui" %>

<main class="account-picker">
  <section class="account-picker__panel" aria-labelledby="account-picker-title">
    <h1 id="account-picker-title">Manage Accounts</h1>

    <div class="profile-grid">
      <% @accounts.each do |account| %>
        <div class="profile-card">
          <%= link_to account_path(account), class: "profile-card__button", aria: { label: "Open #{account.name}" } do %>
            <span class="profile-card__avatar">
              <% if account.profile_image_url.present? %>
                <img src="<%= account.profile_image_url %>" alt="">
              <% else %>
                <span><%= account.name.to_s.first&.upcase || "Y" %></span>
              <% end %>
            </span>
            <span class="profile-card__name"><%= account.name %></span>
          <% end %>

          <%= link_to "Edit", edit_account_path(account), class: "profile-card__edit" %>
        </div>
      <% end %>

      <%= link_to new_account_path, class: "profile-card profile-card--new", aria: { label: "Create a new account" } do %>
        <span class="profile-card__avatar profile-card__avatar--new">+</span>
        <span class="profile-card__name">New account</span>
      <% end %>
    </div>
  </section>
</main>
